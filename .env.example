# Copy this file to ".env" and fill in your values, then run: npm start
# The .env file is git-ignored, so your key stays local and is never committed.

# Claude (Anthropic) API key — enables the coach for everyone using this server.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: change the port the app is served on (default 4173).
# PORT=4173

# Optional: where the AI Builder app runs (default http://localhost:4280).
# BUILDER_URL=http://localhost:4280
