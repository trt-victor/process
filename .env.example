# Local: copy this file to ".env", fill in your values, then run: npm start   (.env is git-ignored)
# Vercel / Azure: set the same names as environment variables in the project settings instead.

# Claude (Anthropic) API key: enables the coach and handwriting-to-text for everyone using this app.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase: keeps every session's board and coach chat on the server (run supabase/schema.sql once).
# Use the SECRET / service_role key (Project Settings > API Keys), never expose it in the browser.
# Leave empty locally to save sessions as files in data/sessions instead.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional
# MODEL=claude-opus-5-5             # Claude model for the coach
# HANDWRITING_MODEL=claude-opus-5-5 # model that reads handwritten notes
# PORT=4173
# HOST=0.0.0.0                       # listen on the network (e.g. a touchscreen on the same Wi-Fi)
# BUILDER_URL=http://localhost:4280